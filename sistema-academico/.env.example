# Copiar como .env.production (front) y llenar con valores reales.
# Este archivo SI se sube a Git: solo tiene nombres y valores de ejemplo.

# Front (Vite): direccion de la API. En produccion, la IP publica de la EC2.
VITE_API_URL=http://IP-PUBLICA-DE-LA-EC2

# API (Node): puerto donde escucha Express. En la EC2 se usa 80.
PORT=3000
